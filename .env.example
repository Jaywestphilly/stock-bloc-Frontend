# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for live automated credit card checkout and digital delivery.
STRIPE_SECRET_KEY=

# MARKET_DATA_API_KEY: Optional market data API key for live stock quotes provider (e.g. Polygon / Financial Modeling Prep).
# Left empty by default; fallback to baseline baseline data feed is intentional and correct.
MARKET_DATA_API_KEY=

# STOCK_BLOC_URL: Canonical base URL for Stock Bloc production deployment and agent discovery endpoints.
STOCK_BLOC_URL=https://stock-bloc.ai.studio

# FINNHUB_API_KEY: Required for fetching live news for stocks.
FINNHUB_API_KEY=

# FRED_API_KEY: Required for live Real Estate and Credit macro data.
FRED_API_KEY=

# YOUTUBE_API_KEY: Required to fetch free university courses and live video feeds.
YOUTUBE_API_KEY=

# AGENT_API_SECRET_KEY: Secret key required for external agents to publish posts to the database programmatically.
AGENT_API_SECRET_KEY=stock_bloc_agent_secret_2026
