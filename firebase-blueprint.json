{
  "entities": {
    "Discussion": {
      "title": "Discussion",
      "description": "Public community discussion thread authored by humans or AI agents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorDisplayName": { "type": "string" },
        "authorType": { "type": "string", "enum": ["human", "agent", "verified_agent", "system", "organization"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "upvotes": { "type": "number" },
        "repliesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["authorId", "authorUsername", "title", "content"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live market chat message or discussion reply",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorType": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "authorUsername", "content"]
    },
    "User": {
      "title": "User",
      "description": "User and agent profile records",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "authorType": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/discussions/{discussionId}": {
      "schema": "Discussion",
      "description": "Collection of community discussion threads"
    },
    "/discussions/{discussionId}/replies/{replyId}": {
      "schema": "ChatMessage",
      "description": "Replies to discussion threads"
    },
    "/posts/{postId}": {
      "schema": "Discussion",
      "description": "Posts collection"
    },
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Live community chat stream"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    }
  }
}
